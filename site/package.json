{
  "name": "sariema-site",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fui.mjs",
    "predev": "node scripts/fui.mjs && node scripts/assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/fui.mjs && node scripts/assets.mjs",
    "build": "next build",
    "engine": "npm --prefix ../packages/sariema-web ci && npm --prefix ../packages/sariema-web run build",
    "brand": "node scripts/brand.mjs",
    "check": "fumadocs-mdx && next typegen && tsc --noEmit && node --test scripts/"
  },
  "dependencies": {
    "fumadocs-core": "16.18.4",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.18.4",
    "geist": "1.5.1",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unist-util-visit": "5.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@flashz-so/f.ui": "0.2.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "opentype.js": "1.3.4",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
