{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sariema input log",
  "description": "A recorded input: the steps at which actions changed. An action keeps its value until a later change names it. Replaying it gives the same simulation at any display rate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["changes"],
  "properties": {
    "changes": {
      "type": "array",
      "description": "In increasing step order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step"],
        "properties": {
          "step": { "type": "integer", "minimum": 0, "description": "Simulation step, 60 per second." },
          "axes": {
            "type": "object",
            "description": "Axis action name to its new value, x then y, each in [-1, 1].",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "number", "minimum": -1, "maximum": 1 },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "down": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Button actions pressed at this step." },
          "up": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Button actions released at this step." }
        }
      }
    }
  }
}
